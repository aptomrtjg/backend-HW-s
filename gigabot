bot.on("message:text", async (ctx) => {
    const text = ctx.message.text.toLowerCase();

    if (text === "hello" || text === "привіт") {
        await ctx.reply("О, привіт! Радий тебе бачити! 👋");
        return;
    }

    if (text === "help") {
        await ctx.reply("Схоже, ти шукаєш допомогу? Спробуй використати команду /help");
        return;
    }

    await ctx.reply(`Я отримав твоє повідомлення: ${ctx.message.text}`);
});

